            }
          }





    - path: /var/oem/scripts/secrets-create.sh
      mode: 0750
      overwrite: true
      contents:
        inline: |

          set -euo pipefail




          create() {
            local secret_name="$1"
            local secret_file="/run/secrets/$2.env"
            [[ -r "$secret_file" ]] || { echo "FATAL: missing $secret_file" >&2; exit 1; }
            local secret_value
            secret_value=$(cut -d= -f2- "$secret_file")
            local tmpfile
            tmpfile=$(mktemp /run/secrets/.podman-secret.XXXXXXXX) || return 1
            trap 'rm -f "$tmpfile"' RETURN EXIT
            printf '%s' "$secret_value" > "$tmpfile"
            chmod 0600 "$tmpfile"
            sudo -u containers /usr/bin/podman secret create --replace "$secret_name" "$tmpfile"
            local rc=$?
            rm -f "$tmpfile"
            trap - RETURN EXIT
            return $rc
          }

          create node-a1-cloudflare-api-token   dns_key
          create node-a1-arcane-encryption-key  encryption_key
          create node-a1-arcane-jwt-secret      jwt_secret

          echo "Podman secrets created"



    - path: /etc/nftables/node-a1-egress.nft
      mode: 0644
      contents:
        inline: |
            table ip node_a1_egress {
              chain input {
                type filter hook input priority filter; policy accept;

                meta skuid { 5000, 100998, 100999, 101000, 101001, 101002 } ct state established,related accept
              }
              chain output {
                type filter hook output priority filter; policy accept;

                meta skuid { 5000, 100998, 100999, 101000, 101001, 101002 } ct state established,related accept









                  meta skuid { 5000, 100998, 100999, 101000, 101001, 101002 } ip daddr 127.0.0.0/8 accept


                meta skuid 5000 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "S3 backup/registry"
                meta skuid 5000 udp dport 53 accept comment "DNS resolution"
                meta skuid 5000 tcp dport 53 accept comment "DNS over TCP"
                meta skuid 5000 tcp dport 443 accept comment "HTTPS internet access"
                meta skuid 5000 tcp dport 80 accept comment "HTTP internet access"


                meta skuid 101002 ip daddr ${node_gateway} udp dport 53 accept comment "DNS via DMZ gateway"
                meta skuid 101002 ip daddr ${node_gateway} tcp dport 53 accept comment "DNS over TCP"
                meta skuid 101002 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "S3 storage"
                meta skuid 101002 tcp dport 443 accept comment "CloudFlare API for SSL"
                meta skuid 101002 tcp dport 80 accept comment "CloudFlare API fallback"
                meta skuid 101002 ip daddr ${node_gateway} tcp dport 4991 accept comment "Backend to Sharkord"


                meta skuid 100998 ip daddr ${node_gateway} udp dport 53 accept comment "DNS via DMZ gateway only"
                meta skuid 100998 ip daddr ${node_gateway} tcp dport 53 accept comment "DNS over TCP"
                meta skuid 100998 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "S3 backup only"
                meta skuid 100998 ip daddr ${node_gateway} accept comment "DMZ VLAN access"
                meta skuid 100998 ip daddr 192.0.2.0/24 accept comment "Restricted VLAN access"
                meta skuid 100998 ip daddr 198.51.100.0/24 accept comment "Restricted VLAN access"


                meta skuid 100999 ip daddr ${node_gateway} udp dport 53 accept comment "DNS via DMZ gateway"
                meta skuid 100999 ip daddr ${node_gateway} tcp dport 53 accept comment "DNS over TCP"
                meta skuid 100999 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "S3 backup only"
                meta skuid 100999 ip daddr ${node_gateway} accept comment "DMZ VLAN access"


                meta skuid 101000 ip daddr ${node_gateway} udp dport 53 accept comment "DNS via DMZ gateway only"
                meta skuid 101000 ip daddr ${node_gateway} tcp dport 53 accept comment "DNS over TCP"
                meta skuid 101000 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "S3 backup only"
                meta skuid 101000 ip daddr ${node_gateway} accept comment "DMZ VLAN access"


                meta skuid 101001 ip daddr ${node_gateway} tcp dport { 443, 9000 } accept comment "Registry/S3"
                meta skuid 101001 udp dport 53 accept comment "DNS via DMZ gateway"
                meta skuid 101001 tcp dport 53 accept comment "DNS over TCP"
                meta skuid 101001 tcp dport 443 accept comment "HTTPS internet access"
                meta skuid 101001 ip daddr ${network_subnet} tcp dport { 3552, 3553 } accept comment "Arcane agents"
                meta skuid 101001 ip daddr ${node_gateway} tcp dport { 4991, 8080, 8096 } accept comment "Backend services"


                meta skuid 5000 log prefix "NODE-A1-MGMT-BLOCKED: " drop
                meta skuid 100998 log prefix "NODE-A1-SHARKORD-BLOCKED: " drop
                meta skuid 100999 log prefix "NODE-A1-FILEGATOR-BLOCKED: " drop
                meta skuid 101000 log prefix "NODE-A1-JELLYFIN-BLOCKED: " drop
                meta skuid 101001 log prefix "NODE-A1-ARCANE-BLOCKED: " drop
                meta skuid 101002 log prefix "NODE-A1-CADDY-BLOCKED: " drop
             }
            }


    - path: /var/oem/scripts/Caddyfile
      mode: 0644
      overwrite: true
      contents:
        inline: |
          {
              email admin@example.com
          }

          *.int.example.com {
              tls {
                  dns cloudflare {env.CLOUDFLARE_API_TOKEN}
              }

              @chat host chat.example.com
              handle @chat {
                  reverse_proxy sharkord:4991
              }

              @rtc host rtc.example.com
              handle @rtc {
                  reverse_proxy sharkord:40000
              }

              @files host files.example.com
              handle @files {
                  reverse_proxy filegator:8080
              }

              @media host media.example.com
              handle @media {
                  reverse_proxy jellyfin:8096
              }

              @arcane host arcane.example.com
                handle @arcane {
                    reverse_proxy arcane:3552
                }

              handle {
                  respond "Not Found" 404
              }
          }







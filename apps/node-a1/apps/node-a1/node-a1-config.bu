    - path: /home/containers/.config/containers/policy.json
      mode: 0644
      overwrite: true
      user:
        name: containers
      group:
        name: containers
      contents:
        inline: |
          {
            "default": [
              {
                "type": "reject"
              }
            ],
            "transports": {
              "docker": {
                "docker.io": [
                  {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPath": "/etc/pki/containers/registry-signing-key.pub",
                    "signedIdentity": {
                      "type": "matchRepoDigestOrExact"
                    }
                  }
                ],
                "ghcr.io": [
                  {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPath": "/etc/pki/containers/registry-signing-key.pub",
                    "signedIdentity": {
                      "type": "matchRepoDigestOrExact"
                    }
                  }
                ],
                "codeberg.org": [
                  {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPath": "/etc/pki/containers/registry-signing-key.pub",
                    "signedIdentity": {
                      "type": "matchRepoDigestOrExact"
                    }
                  }
                ],
                "code.forgejo.org": [
                  {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPath": "/etc/pki/containers/registry-signing-key.pub",
                    "signedIdentity": {
                      "type": "matchRepoDigestOrExact"
                    }
                  }
                ]
              },
              "docker-archive": {
                "": [
                  {
                    "type": "signedBy",

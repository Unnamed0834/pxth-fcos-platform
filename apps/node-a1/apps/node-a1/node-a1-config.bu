variant: flatcar
version: 1.0.0


systemd:
  units:
    - name: oem-extract.service

      enabled: true
      contents: |
        [Unit]
        Description=Extract Base OEM Artifacts
        After=local-fs.target
        Before=node-a1-sysexts-install.service
        ConditionPathExists=!/var/oem/.base-extracted

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=-/bin/mkdir -p /var/oem
        ExecStartPre=-/bin/mkdir -p /var/log



        ExecStartPre=/bin/bash /var/oem-check.sh /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi9
        ExecStart=/bin/tar xzf /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi9 -C /var/oem
        ExecStartPost=/bin/touch /var/oem/.base-extracted
        ExecStartPost=/bin/bash -c 'find /var/oem/scripts -type f -exec chmod +x {} + 2>/dev/null || true'



        ExecStartPost=/bin/chown -R root:root /var/oem
        ExecStartPost=/bin/bash -c 'find /var/oem -type d -exec chmod 0755 {} +'
        ExecStartPost=/bin/bash -c 'find /var/oem -type f -exec chmod 0644 {} +'
        ExecStartPost=/bin/bash -c 'find /var/oem/scripts -type f -name "*.sh" -exec chmod 0750 {} +'



        [Install]
        WantedBy=multi-user.target


    - name: node-a1-sysexts-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install podman sysext from OEM and merge via systemd-sysext
        After=oem-extract.service local-fs.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes


        ExecStart=/bin/bash -c 'mkdir -p /etc/extensions'
        ExecStart=/bin/bash -c 'cp -f /var/oem/sysext/podman.raw /etc/extensions/flatcar-podman.raw'

        ExecStart=/bin/systemctl restart systemd-sysext

        ExecStart=/bin/bash -c 'mkdir -p /opt/bin && bunzip2 -c /var/oem/bin/restic.bz2 > /opt/bin/restic && chmod +x /opt/bin/restic'

        [Install]
        WantedBy=multi-user.target


    - name: sshd.service
      enabled: true




    - name: serial-getty@ttyS0.service
      enabled: false
      mask: true




    - name: console-loglevel.service
      enabled: true
      contents: |
        [Unit]
        Description=Set console log level to suppress audit spam on serial console
        After=local-fs.target
        DefaultDependencies=no

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/sh -c 'echo 4 > /proc/sys/kernel/printk'

        [Install]
        WantedBy=multi-user.target




    - name: update-engine.service
      enabled: true
      mask: false

    - name: locksmithd.service
      enabled: true
      mask: false
      dropins:
        - name: 10-reboot-window.conf
          contents: |
            [Unit]
            Wants=locksmithd-reboot-window.service
            After=locksmithd-reboot-window.service

    - name: locksmithd-reboot-window.service
      enabled: true
      contents: |
        [Unit]
        Description=Configure bounded Locksmith reboot window for OS updates

        [Service]
        Type=oneshot
        RemainAfterExit=yes


        ExecStart=/bin/bash -c 'mkdir -p /etc/systemd/system/locksmithd.service.d && \
          printf "[Service]\nEnvironment=LOCKSMITHD_REBOOT_STRATEGY=reboot\nEnvironment=LOCKSMITHD_REBOOT_WINDOW_START=03:00\nEnvironment=LOCKSMITHD_REBOOT_WINDOW_LENGTH=1h\n" \
          > /etc/systemd/system/locksmithd.service.d/10-reboot-window.conf'

        [Install]
        WantedBy=multi-user.target


    - name: podman-bridge-stp.service
      enabled: true
      contents: |
        [Unit]
        Description=Disable STP on Podman bridges
        After=network-online.target
        DefaultDependencies=no

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'for b in $(ls /sys/class/net/ 2>/dev/null | grep "^podman"); do ip link set "$b" type bridge stp_state 0; done'

        [Install]
        WantedBy=multi-user.target


    - name: podman-group-create.service
      enabled: true
      contents: |
        [Unit]
        Description=Create podman group
        Before=systemd-user-sessions.service
        ConditionPathExists=!/etc/podman-group-created

        [Service]
        Type=oneshot
        RemainAfterExit=yes

        ExecStart=/usr/sbin/groupadd -f -g 5500 podman
        ExecStartPost=/bin/touch /etc/podman-group-created

        [Install]
        WantedBy=multi-user.target


    - name: containers-linger-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable linger for containers user
        After=podman-group-create.service create-run-containers.service
        Wants=create-run-containers.service
        ConditionPathExists=!/etc/containers-linger-enabled

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/loginctl enable-linger containers
        ExecStartPost=/bin/touch /etc/containers-linger-enabled

        [Install]
        WantedBy=multi-user.target


    - name: podman-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable rootless Podman for containers user
        After=podman-group-create.service containers-linger-enable.service
        ConditionPathExists=!/etc/podman-enabled

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'mkdir -p /home/containers/.local/share/containers/storage'
        ExecStart=/bin/bash -c 'mkdir -p /home/containers/.config/containers'
        ExecStart=/bin/bash -c 'mkdir -p /home/containers/.run'


        ExecStart=/bin/bash -c 'chown -R containers:containers /home/containers/.local /home/containers/.config /home/containers/.run'
        ExecStartPost=/bin/touch /etc/podman-enabled

        [Install]
        WantedBy=multi-user.target


    - name: network-ready.service
      enabled: true
      contents: |
        [Unit]
        Description=Network Ready Indicator
        After=network-online.target
        Before=multi-user.target
        DefaultDependencies=no

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'mkdir -p /run/user/0 && chown root:root /run/user/0 && touch /run/user/0/network-ready'

        [Install]
        WantedBy=network-online.target





    - name: node-a1-egress-policy.service
      enabled: true
      contents: |
        [Unit]
        Description=Egress nftables policy for container UIDs
        After=network-online.target
        Before=node-a1-containers.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/sbin/nft -f /etc/nftables/node-a1-egress.nft
        ExecStop=/usr/sbin/nft delete table ip node_a1_egress

        [Install]
        WantedBy=multi-user.target

    - name: zerotier-route.service
      enabled: true
      contents: |
        [Unit]
        Description=Add route to ZeroTier network via gateway
        After=network-online.target
        Before=multi-user.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/ip route add 192.0.2.0/24 via ${zerotier_gateway} dev eth0
        ExecStop=/bin/ip route del 192.0.2.0/24 via ${zerotier_gateway} dev eth0

        [Install]
        WantedBy=multi-user.target

    - name: apply-unprivileged-ports.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply unprivileged port sysctl early
        Before=network.target systemd-sysctl.service
        DefaultDependencies=no

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/sbin/sysctl -p /etc/sysctl.d/99-unprivileged-ports.conf

        [Install]
        WantedBy=multi-user.target




    - name: create-run-containers.service
      enabled: true
      contents: |
        [Unit]
        Description=Create XDG_RUNTIME_DIR for containers user
        Before=systemd-user-sessions.service
        DefaultDependencies=no

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'mkdir -p /var/lib/containers/run && chown containers:containers /var/lib/containers/run && chmod 700 /var/lib/containers/run'

        [Install]
        WantedBy=multi-user.target








    - name: node-a1-secrets-create.service
      enabled: true
      contents: |
        [Unit]
        Description=Create Podman secrets for NODE node-a1 containers
        After=node-a1-sysexts-install.service user@5000.service containers-linger-enable.service
        Before=node-a1-containers.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        User=root
        Environment="HOME=/root"


        ExecStartPre=/bin/mkdir -p /run/secrets
        ExecStartPre=/bin/chmod 0700 /run/secrets
        ExecStart=/var/oem/scripts/secrets-create.sh

        [Install]
        WantedBy=multi-user.target





    - name: node-a1-restic-secrets.service
      enabled: true
      contents: |
        [Unit]
        Description=Write Restic S3 Credentials to tmpfs
        After=oem-extract.service
        Requires=oem-extract.service

        [Service]
        Type=oneshot
        ExecStartPre=/bin/mkdir -p /run/secrets
        ExecStart=/bin/bash -c '\
          echo "AWS_ACCESS_KEY_ID=$$(cat /run/secrets/s3_backup_access_key_id.env | cut -d= -f2-)" > /run/secrets/restic.env; \
          echo "AWS_SECRET_ACCESS_KEY=$$(cat /run/secrets/s3_backup_secret_access_key.env | cut -d= -f2-)" >> /run/secrets/restic.env'
        ExecStartPost=/bin/chmod 0600 /run/secrets/restic.env
        ExecStartPost=/bin/chown root:root /run/secrets/restic.env

        [Install]
        WantedBy=multi-user.target


    - name: node-a1-backup-restore.service
      enabled: true
      contents: |
        [Unit]
        Description=Restore NODE node-a1 volumes from Restic Backup
        After=systemd-user-sessions.service node-a1-containers-load.service podman-enable.service create-run-containers.service node-a1-secrets-create.service node-a1-restic-secrets.service
        Wants=systemd-user-sessions.service node-a1-containers-load.service podman-enable.service create-run-containers.service node-a1-secrets-create.service node-a1-restic-secrets.service
        ConditionPathExists=/var/oem/.containers-loaded
        ConditionPathExists=!/var/oem/.backup-restored

        [Service]
        Type=oneshot
        User=root
        EnvironmentFile=/run/secrets/restic.env
        ExecStartPre=/bin/bash -c 'mkdir -p /home/containers/volumes'
        ExecStart=/bin/bash -c '\
            RESTIC=/opt/bin/restic; \
            if [ ! -f "$RESTIC" ]; then echo "Restic not found at $RESTIC"; exit 1; fi; \
            export RESTIC_REPOSITORY="s3:$(cat /run/secrets/s3_backup_endpoint.env | cut -d= -f2-)/$(cat /run/secrets/s3_backup_bucket.env | cut -d= -f2-)/restic-node-a1"; \
            export RESTIC_PASSWORD="$(cat /run/secrets/s3_backup_restic_password.env | cut -d= -f2-)"; \
            snapshots=$($RESTIC --repo "$RESTIC_REPOSITORY" snapshots --json 2>&1); \
            rc=$?; \
            if [ $rc -ne 0 ]; then \
                echo "Cannot access repo (exit $rc): $snapshots"; \
                exit 1; \
            fi; \
            if [ "$snapshots" = "[]" ] || [ -z "$snapshots" ]; then \
                echo "No snapshots found, skipping restore"; \
                exit 0; \
            fi; \
            echo "Restoring latest snapshot..."; \
            $RESTIC --repo "$RESTIC_REPOSITORY" restore latest --target /; \
            chown containers:containers /home/containers/volumes; \
             chown -R 101002:101002 /home/containers/volumes/caddy-data; \
             chown -R 101002:101002 /home/containers/volumes/caddy-config; \
             chown -R 100998:100998 /home/containers/volumes/sharkord-data; \
             chown -R 100999:100999 /home/containers/volumes/filegator-private; \
             chown -R 101000:101000 /home/containers/volumes/jellyfin-config; \
             chown -R 101000:101000 /home/containers/volumes/jellyfin-cache; \
             chown -R 101001:101001 /home/containers/volumes/arcane-data; \
            chown -R containers:containers /home/containers/.config/containers 2>/dev/null || true'
        ExecStartPost=/bin/touch /var/oem/.backup-restored

        [Install]
        WantedBy=multi-user.target






    - name: node-a1-netns-mount.service
      enabled: true
      contents: |
        [Unit]
        Description=Mount tmpfs for netavark rootless network namespace
        After=create-run-containers.service
        Before=node-a1-containers.service selinux-container-labels.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c '\
          mkdir -p /var/lib/containers/run/containers/networks/rootless-netns && \
          mountpoint -q /var/lib/containers/run/containers/networks/rootless-netns || \
          mount -t tmpfs -o size=16m,mode=0755,context="system_u:object_r:iptables_runtime_t" \
            tmpfs /var/lib/containers/run/containers/networks/rootless-netns && \
          chown containers:containers /var/lib/containers/run/containers/networks/rootless-netns'

        [Install]
        WantedBy=multi-user.target


    - name: selinux-setup.service
      enabled: true
      contents: |
        [Unit]
        Description=Setup SELinux enforcement
        After=local-fs.target
        Before=node-a1-containers.service
        ConditionPathExists=!/etc/selinux-setup-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'rm -f /etc/audit/rules.d/80-selinux.rules /etc/audit/rules.d/99-default.rules'
        ExecStart=/bin/bash -c 'rm -rf /etc/selinux/mcs; cp -a /usr/lib/selinux/mcs /etc/selinux/'
        ExecStart=/bin/bash -c 'rm -rf /var/lib/selinux; cp -a /usr/lib/selinux/policy /var/lib/selinux/'




        ExecStart=/usr/bin/systemctl restart audit-rules
        ExecStartPost=/bin/touch /etc/selinux-setup-complete

        [Install]
        WantedBy=multi-user.target




    - name: selinux-container-labels.service
      enabled: true
      contents: |
        [Unit]
        Description=Pre-create and label Podman storage for SELinux
        After=selinux-setup.service podman-enable.service create-run-containers.service node-a1-sysexts-install.service
        Before=node-a1-containers.service
        ConditionPathExists=/etc/selinux-setup-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/bash -c 'set -e; mkdir -p \
           /home/containers/.local/share/containers/storage \
           /home/containers/.local/share/containers/storage/overlay \
           /home/containers/.local/share/containers/storage/overlay-layers \
           /home/containers/.local/share/containers/storage/overlay-images \
           /home/containers/.local/share/containers/storage/volumes \
           /home/containers/.local/share/containers/storage/libpod \
           /home/containers/.config/containers \
           /home/containers/.run/containers'
        ExecStart=/bin/bash -c 'semanage fcontext -a -t container_file_t "/home/containers/.local/share/containers(/.*)?" 2>/dev/null || true; semanage fcontext -a -t container_file_t "/home/containers/.config/containers(/.*)?" 2>/dev/null || true; semanage fcontext -a -t container_file_t "/home/containers/.run(/.*)?" 2>/dev/null || true; semanage fcontext -a -t container_file_t "/home/containers/volumes(/.*)?" 2>/dev/null || true'
        ExecStart=/bin/bash -c 'restorecon -RF /home/containers 2>/dev/null || true'
        ExecStart=/bin/bash -c 'chcon -R -t container_file_t /home/containers/.local/share/containers /home/containers/.config/containers /home/containers/volumes 2>/dev/null || true'
        ExecStart=/bin/bash -c 'chcon -R -t container_runtime_t /var/lib/containers/run 2>/dev/null || true'
        ExecStart=/bin/bash -c 'chown -R containers:containers /home/containers/.local/share/containers /home/containers/.config/containers /home/containers/.run 2>/dev/null || true; echo "Podman storage pre-created and labeled"'

        [Install]
        WantedBy=multi-user.target





    - name: node-a1-containers-load.service
      enabled: true
      contents: |
        [Unit]
        Description=Load NODE node-a1 Container Images for Podman
        After=systemd-user-sessions.service oem-extract.service node-a1-sysexts-install.service selinux-container-labels.service
        Wants=systemd-user-sessions.service oem-extract.service node-a1-sysexts-install.service selinux-container-labels.service
        ConditionPathExists=/var/oem/containers
        ConditionPathExists=!/var/oem/.containers-loaded

        [Service]
        Type=oneshot
        User=root
        RemainAfterExit=yes
        ExecStartPre=/bin/bash -c 'mkdir -p /home/containers/.local/share/containers/storage'
        ExecStartPre=/bin/bash -c 'mkdir -p /home/containers/.config/containers'
        ExecStartPre=/bin/bash -c 'chown -R containers:containers /home/containers/.local /home/containers/.config /home/containers/.run 2>/dev/null || true'
        ExecStart=/bin/bash -c '\
            loaded=0; \
            failed=0; \
            for component in /var/oem/containers/*; do \
                [ -d "$component" ] || continue; \
                for tar in "$component"/*.tar; do \
                    [ -f "$tar" ] || continue; \
                    if su - containers -c "XDG_RUNTIME_DIR=/run/user/5000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/5000/bus /usr/bin/podman load -i $tar" 2>&1; then \
                        loaded=$((loaded + 1)); \
                    else \
                        failed=$((failed + 1)); \
                    fi; \
                done; \
            done; \
            echo "Loaded $loaded images, $failed failed"; \
            [ $failed -eq 0 ] || exit 1'
        ExecStartPost=/bin/touch /var/oem/.containers-loaded

        [Install]
        WantedBy=multi-user.target






    - name: podman-socket-activate.service
      enabled: true
      contents: |
        [Unit]
        Description=Podman API socket service for containers user
        After=user@5000.service containers-linger-enable.service create-run-containers.service node-a1-sysexts-install.service
        Before=node-a1-containers.service

        [Service]
        Type=simple
        User=containers
        Environment="HOME=/home/containers"
        Environment="XDG_RUNTIME_DIR=/run/user/5000"
        ExecStartPre=/bin/mkdir -p /run/user/5000/podman


        ExecStart=/usr/bin/podman system service --time=0




        ExecStartPost=/bin/bash -c '\
          for i in $(seq 1 30); do \
            [ -S /run/user/5000/podman/podman.sock ] && \
              chmod 0660 /run/user/5000/podman/podman.sock && \
              exit 0; \
            sleep 1; \
          done; \
          echo "ERROR: podman.sock not ready after 30s"; exit 1'
        Restart=always
        RestartSec=5

        [Install]
        WantedBy=multi-user.target


    - name: node-a1-containers.service
      enabled: true
      contents: |
        [Unit]
        Description=NODE node-a1 Node Containers (Podman Rootless)
        After=systemd-user-sessions.service network-ready.service node-a1-containers-load.service node-a1-backup-restore.service podman-enable.service apply-unprivileged-ports.service selinux-container-labels.service create-run-containers.service node-a1-netns-mount.service podman-socket-activate.service node-a1-secrets-create.service node-a1-egress-policy.service nfs-public-mounts.service
        Requires=systemd-user-sessions.service network-ready.service node-a1-containers-load.service podman-enable.service apply-unprivileged-ports.service selinux-container-labels.service create-run-containers.service node-a1-netns-mount.service podman-socket-activate.service node-a1-secrets-create.service node-a1-egress-policy.service nfs-public-mounts.service
        Wants=node-a1-backup-restore.service
        ConditionPathExists=/var/oem/.containers-loaded
        ConditionPathExists=/var/oem/scripts/Caddyfile

        [Service]
        Type=oneshot
        User=containers
        Environment="HOME=/home/containers"
        Environment="XDG_RUNTIME_DIR=/run/user/5000"
        Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/5000/bus"
        RemainAfterExit=yes
        TimeoutStartSec=0

        ExecStartPre=/bin/bash -c '/usr/bin/podman network create frontend 2>/dev/null || true'


        ExecStart=/usr/bin/podman run -d --restart=always --replace \
              --name sharkord \
              --network frontend \
              --user 999:999 \
             --workdir /app/data \
             --env HOME=/app/data \
             --env RUNNING_IN_DOCKER=true \
             --env SHARKORD_WEBRTC_ANNOUNCED_ADDRESS=rtc.example.com \
             --env MEDIASOUP_WORKER_RTC_MIN_PORT=40001 \
             --env MEDIASOUP_WORKER_RTC_MAX_PORT=40020 \
             --publish 40000:40000/tcp \
             --publish 40000:40000/udp \
             --publish 40001-40020:40001-40020/udp \
             --security-opt no-new-privileges \
             --memory 1024m --pids-limit 128 \
             --volume /home/containers/volumes/sharkord-data:/app/data:Z \
             --entrypoint /sharkord \
             ${sharkord_image}




        ExecStart=/usr/bin/podman run -d --restart=always --replace \
              --name caddy \
              --network frontend \
              --user 1003:1003 \
             --publish 80:80 \
             --publish 443:443 \
             --security-opt no-new-privileges \
             --cap-add CAP_NET_BIND_SERVICE \
             --memory 256m --pids-limit 128 \
             --volume /home/containers/volumes/caddy-data:/data:Z \
             --volume /home/containers/volumes/caddy-config:/config:Z \
             --volume /var/oem/scripts/Caddyfile:/etc/caddy/Caddyfile:ro,Z \
             --secret node-a1-cloudflare-api-token,type=env,target=CLOUDFLARE_API_TOKEN \
             ${caddy_image}


        ExecStart=/usr/bin/podman run -d --restart=always --replace \
              --name filegator \
              --network frontend \
              --user 1000:1000 \
             --security-opt no-new-privileges \
             --memory 512m --pids-limit 128 \
             --volume /home/containers/volumes/filegator-private:/var/www/filegator/private:Z \
             --volume ${nfs_mount_point}/games:/var/www/filegator/repository:ro,Z \
             ${filegator_image}


        ExecStart=/usr/bin/podman run -d --restart=always --replace \
              --name jellyfin \
              --network frontend \
              --user 1001:1001 \
             --security-opt no-new-privileges \
             --memory 2048m --pids-limit 256 \
             --volume /home/containers/volumes/jellyfin-config:/config:Z \
             --volume /home/containers/volumes/jellyfin-cache:/cache:Z \
             --volume ${nfs_mount_point}/video:/public/video:ro,Z \
             --volume ${nfs_mount_point}/audio:/public/audio:ro,Z \
             --env JELLYFIN_PublishedServerUrl=https://media.example.com \
             ${jellyfin_image}


        ExecStart=/usr/bin/podman run -d --restart=always --replace \
              --name arcane \
              --network frontend \
              --user 1002:1002 \
             --security-opt no-new-privileges \
             --memory 5120m --pids-limit 128 \
             --secret node-a1-arcane-encryption-key,type=env,target=ENCRYPTION_KEY \
             --secret node-a1-arcane-jwt-secret,type=env,target=JWT_SECRET \
             --volume /home/containers/volumes/arcane-data:/app/data:Z \
             ${arcane_image}

        [Install]
        WantedBy=multi-user.target


    - name: nfs-public-mounts.service
      enabled: true
      contents: |
        [Unit]
        Description=Mount individual NFS public shares (read-only, all_squash)
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/bin/bash -c 'mkdir -p ${nfs_mount_point}/video ${nfs_mount_point}/audio ${nfs_mount_point}/games'
        ExecStart=/bin/mount -t nfs4 -o ro,relatime ${nfs_server}:/mnt/storage/public/video ${nfs_mount_point}/video
        ExecStart=/bin/mount -t nfs4 -o ro,relatime ${nfs_server}:/mnt/storage/public/audio ${nfs_mount_point}/audio
        ExecStart=/bin/mount -t nfs4 -o ro,relatime ${nfs_server}:/mnt/storage/public/games ${nfs_mount_point}/games
        ExecStop=/bin/bash -c 'umount ${nfs_mount_point}/video ${nfs_mount_point}/audio ${nfs_mount_point}/games 2>/dev/null || true'
        TimeoutStartSec=60

        [Install]
        WantedBy=multi-user.target


    - name: node-a1-backup.service
      contents: |
        [Unit]
        Description=NODE node-a1 Daily Backup (Restic to S3)
        After=systemd-user-sessions.service network-online.target node-a1-containers.service node-a1-restic-secrets.service
        Wants=systemd-user-sessions.service network-online.target node-a1-restic-secrets.service


        [Service]
        Type=oneshot
        User=root
        EnvironmentFile=/run/secrets/restic.env
        ExecStart=/bin/bash -c '\
            RESTIC=/opt/bin/restic; \
            export RESTIC_REPOSITORY="s3:$(cat /run/secrets/s3_backup_endpoint.env | cut -d= -f2-)/$(cat /run/secrets/s3_backup_bucket.env | cut -d= -f2-)/restic-node-a1"; \
            export RESTIC_PASSWORD="$(cat /run/secrets/s3_backup_restic_password.env | cut -d= -f2-)"; \
            $RESTIC backup \
               /home/containers/volumes/arcane-data \
               /home/containers/volumes/caddy-data \
               /home/containers/volumes/caddy-config \
               /home/containers/volumes/sharkord-data \
               /home/containers/volumes/filegator-private \
               /home/containers/volumes/jellyfin-config \
               /home/containers/volumes/jellyfin-cache \
               /home/containers/.config/containers; \
            rc=$?; [ $rc -le 1 ] && exit 0 || exit $rc'


    - name: node-a1-backup.timer
      enabled: true
      contents: |
        [Unit]
        Description=Daily Backup Timer (NODE node-a1)

        [Timer]
        OnCalendar=daily
        RandomizedDelaySec=3600
        Persistent=true

        [Install]
        WantedBy=timers.target







    - name: node-a1-backup-check.service
      contents: |
        [Unit]
        Description=Weekly Restic Backup Health Check (NODE node-a1)
        After=network-online.target node-a1-restic-secrets.service
        Wants=network-online.target node-a1-restic-secrets.service


        [Service]
        Type=oneshot
        User=root
        EnvironmentFile=/run/secrets/restic.env
        ExecStartPre=/bin/mkdir -p /run/secrets
        ExecStart=/bin/bash -c '\
          RESTIC=/opt/bin/restic; \
            export RESTIC_REPOSITORY="s3:$(cat /run/secrets/s3_backup_endpoint.env | cut -d= -f2-)/$(cat /run/secrets/s3_backup_bucket.env | cut -d= -f2-)/restic-node-a1"; \
            export RESTIC_PASSWORD="$(cat /run/secrets/s3_backup_restic_password.env | cut -d= -f2-)"; \
            SNAPSHOTS=$($RESTIC snapshots --json 2>&1); \
            rc=$?; \
            if [ $rc -ne 0 ]; then echo "Cannot reach restic repository (exit $rc)"; exit 1; fi; \
            CUTOFF=$(date -u -d "8 days ago" +%Y-%m-%dT%H:%M:%S); \
            RECENT=$(echo "$SNAPSHOTS" | /usr/bin/python3 -c \
              "import sys,json; d=json.load(sys.stdin); c='"'"'$CUTOFF'"'"'; \
               print(sum(1 for s in d if s.get('"'"'time'"'"','"'"''"'"')[:19] > c))"); \
            if [ "$RECENT" -eq 0 ]; then \
              echo "ALERT: No restic snapshot in last 8 days. Check node-a1-backup.service."; \
              exit 1; \
            fi; \
            echo "OK: $RECENT snapshot(s) found within last 8 days"'
    - name: node-a1-backup-check.timer
      enabled: true
      contents: |
        [Unit]
        Description=Weekly Backup Health Check Timer (NODE node-a1)

        [Timer]
        OnCalendar=Mon *-*-* 08:00:00
        RandomizedDelaySec=600
        Persistent=true

        [Install]
        WantedBy=timers.target


    - name: node-a1-setup.service
      enabled: true
      contents: |
        [Unit]
        Description=NODE node-a1 Node Setup
        After=oem-extract.service node-a1-sysexts-install.service podman-enable.service network-ready.service create-run-containers.service
        Wants=oem-extract.service node-a1-sysexts-install.service podman-enable.service network-ready.service create-run-containers.service
        ConditionPathExists=/var/oem/scripts/node-a1-setup.sh
        ConditionPathExists=!/etc/node-a1-setup-complete

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        Environment="LOG_FILE=/var/log/node-a1-setup.log"
        SystemCallFilter=~@mount
        ExecStartPre=/bin/bash -c 'echo "$(date): Starting NODE node-a1 setup..." >> /var/log/node-a1-setup.log'
        ExecStart=/var/oem/scripts/node-a1-setup.sh
        TimeoutStartSec=1800
        StandardOutput=journal
        StandardError=journal
        SyslogIdentifier=node-a1-setup

        [Install]
        WantedBy=multi-user.target

storage:
  files:

    - path: /etc/selinux/config
      mode: 0644
      overwrite: true
      contents:
        inline: |
          SELINUX=enforcing
          SELINUXTYPE=targeted


    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: ${node_hostname}


    - path: /etc/timezone
      mode: 0644
      contents:
        inline: UTC



    - path: /etc/systemd/network/10-eth0.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=eth0

          [Network]
           Address=${node_ip}
           Gateway=${node_gateway}
           DNS=${node_dns}
          IPv4SendGratuitousARP=true
          GratuitousARPCount=5


    - path: /etc/sysctl.d/99-system.conf
      mode: 0644
      contents:
        inline: |

          vm.overcommit_memory=1
          vm.mmap_min_addr=65536


          fs.inotify.max_user_watches=524288
          fs.protected_hardlinks=1
          fs.protected_symlinks=1


          kernel.dmesg_restrict=1
          kernel.kptr_restrict=2
          kernel.yama.ptrace_scope=1


          net.core.bpf_jit_harden=2
          net.ipv4.conf.all.log_martians=1
          net.ipv4.conf.default.log_martians=1


    - path: /etc/sysctl.d/99-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start=0




    - path: /var/oem-check.sh
      mode: 0755
      contents:
        inline: |

           DISK="$1"
           EXPECTED_SHA="${OEM_DISK_SHA256}"
             TARBALL_SIZE="${TARBALL_SIZE}"
           if [ -z "$EXPECTED_SHA" ] || [ -z "$TARBALL_SIZE" ]; then
             echo "FATAL: OEM_DISK_SHA256 or TARBALL_SIZE not set"
             exit 1
           fi
           ACTUAL=$(dd if="$DISK" bs=1M 2>/dev/null | head -c "$TARBALL_SIZE" | sha256sum | awk '{print $1}')
           if [ "$ACTUAL" != "$EXPECTED_SHA" ]; then
             echo "FATAL: OEM tarball integrity check FAILED"
             echo "  Expected: $EXPECTED_SHA"
             echo "  Actual:   $ACTUAL"
             echo "  Tarball size: $TARBALL_SIZE bytes"
             exit 1
           fi
           echo "OEM tarball integrity OK: $ACTUAL"


    - path: /etc/ssh/sshd_config.d/99-hardening.conf
      mode: 0644
      contents:
        inline: |
          PermitRootLogin no
          PasswordAuthentication no





    - path: /etc/systemd/journald.conf.d/99-persistence.conf
      mode: 0644
      contents:
        inline: |
          [Journal]
          Storage=persistent
          Compress=yes
          SystemMaxUse=512M
          MaxRetentionSec=30day


    - path: /home/containers/.config/systemd/user/network-ready.service
      mode: 0644
      overwrite: true
      user:
        name: containers
      group:
        name: containers
      contents:
        inline: |
          [Unit]
          Description=User Network Ready (waits for system)
          After=default.target

          [Service]
          Type=oneshot
          RemainAfterExit=yes
          TimeoutSec=120
          ExecStart=/bin/bash -c 'counter=0; while [ ! -e /run/user/0/network-ready ] && [ $counter -lt 60 ]; do sleep 2; counter=$((counter + 1)); done; [ -e /run/user/0/network-ready ] || echo "WARNING: network-ready timeout"'

          [Install]
          WantedBy=default.target



    - path: /home/containers/.config/containers/storage.conf
      mode: 0644
      overwrite: true
      user:
        name: containers
      group:
        name: containers
      contents:
        inline: |
          [storage]
          driver = "overlay"

          [storage.options]
          mount_program = "/usr/bin/fuse-overlayfs"

          [storage.options.overlay]
          mountopt = "nodev"















    - path: /home/containers/.config/containers/containers.conf
      mode: 0644
      overwrite: true
      user:
        name: containers
      group:
        name: containers
      contents:
       inline: |
           [containers]
           cgroup_manager = "cgroupfs"
           events_logger = "file"
           label = false

            [engine]
           events_logger = "file"
           cgroup_manager = "cgroupfs"

           [network]
           network_backend = "netavark"

           [secrets]
           driver = "file"
           options = "driver_opts.path=/home/containers/.secrets"


    - path: /etc/containers/containers.conf
      mode: 0644
      contents:
        inline: |
          [containers]
          cgroup_manager = "cgroupfs"
          events_logger = "file"
          label = false

          [engine]
          events_logger = "file"
          cgroup_manager = "cgroupfs"

          [network]
          network_backend = "netavark"


    - path: /etc/containers/registries.conf
      mode: 0644
      contents:
        inline: |





          unqualified-search-registries = ["docker.io", "ghcr.io", "codeberg.org", "code.forgejo.org", "quay.io"]


          [[registry]]
          prefix = "docker.io"
          location = "docker.io"
          insecure = false

          [[registry]]
          prefix = "ghcr.io"
          location = "ghcr.io"
          insecure = false

          [[registry]]
          prefix = "codeberg.org"
          location = "codeberg.org"
          insecure = false

          [[registry]]
          prefix = "code.forgejo.org"
          location = "code.forgejo.org"
          insecure = false

          [[registry]]
          prefix = "quay.io"
          location = "quay.io"
          insecure = false



    - path: /etc/pki/containers/registry-signing-key.pub
      mode: 0644
